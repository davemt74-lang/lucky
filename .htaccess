Options -Indexes
DirectoryIndex index.php index.html
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^index\.html$ index.php [R=302,L,NC]
RewriteRule ^spin\.html$ game.php [R=302,L,NC]
RewriteRule ^intro\.html$ intro.php [R=302,L,NC]
RewriteRule ^prizes\.html$ admin.php?tab=prizes [R=302,L,NC,QSA]
RewriteRule ^music\.html$ admin.php?tab=music [R=302,L,NC,QSA]
RewriteRule ^claims\.html$ claims.php [R=302,L,NC,QSA]
</IfModule>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
<FilesMatch "^(?:\.env|composer\.(?:json|lock)|.*\.(?:sql|md|log|bak|ini))$">
Require all denied
</FilesMatch>
